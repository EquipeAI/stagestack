{
  "name": "stagestack",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "convex dev --start 'npm run dev -w apps/web'",
    "dev:web": "npm run dev:vite -w apps/web",
    "dev:convex": "convex dev",
    "build:web": "npm run build -w apps/web",
    "build:worker": "npm run build -w apps/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "codegen": "convex codegen"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/resend": "0.2.6",
    "convex": "1.43.0"
  }
}
