# StageStack — every environment variable the code actually reads.
#
# Copy to `.env.local` (that file is git-ignored; this one is the only .env*
# tracked, see .gitignore) and fill in the values. The variables live in THREE
# different places, and putting one in the wrong place is the most common
# self-host failure:
#
#   [web]     `.env.local` at the repo root, mirrored to `apps/web/.env.local`
#             — Vite/TanStack Start reads these at build and request time.
#   [convex]  the Convex DEPLOYMENT, not a file:
#             `npx convex env set NAME value` (or the dashboard).
#             Functions read them through process.env inside the isolate.
#   [worker]  the worker VM's environment (systemd `EnvironmentFile=`), only
#             needed if you run the AI import agent.
#
# Nothing here is a real secret — replace every value.

# ── [web] ────────────────────────────────────────────────────────────────
# Convex deployment URL for the browser/SSR client. REQUIRED: the app throws
# "missing env var VITE_CONVEX_URL" at startup without it. `npx convex dev`
# writes the matching CONVEX_DEPLOYMENT/CONVEX_URL into .env.local for you.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP action origin. Set explicitly for custom/local deployments;
# standard *.convex.cloud deployments can derive the matching *.convex.site.
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk browser key. REQUIRED: sign-in never renders without it, so every
# authenticated surface (/app/**, the speaker portal) is unreachable.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Clerk server key, used by the SSR handler to mint the Convex JWT. REQUIRED:
# without it SSR loads run unauthenticated and organizer pages hydrate empty.
CLERK_SECRET_KEY=sk_test_xxx

# ── [convex] set with `npx convex env set …` ──────────────────────────────
# Clerk's JWT issuer for the "convex" JWT template (e.g.
# https://your-app.clerk.accounts.dev). REQUIRED: every function that resolves
# an identity refuses the token, so the whole app looks logged out.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Resend API key. REQUIRED for any email at all: the Resend component throws
# "API key is not set" inside the sending mutation, which fails the surrounding
# write (an invitation, a decision release) — email is not fire-and-forget.
RESEND_API_KEY=re_xxx

# Whether the Resend component stays in TEST MODE, where it accepts only
# Resend's own test addresses (delivered@resend.dev, …) and rejects everyone
# else. OPTIONAL, and it DEFAULTS TO ON: a fresh clone cannot accidentally mail
# real speakers from a domain it does not own. Set to false/0/no/off (any case)
# once your own sending domain is verified — anything else leaves test mode on.
RESEND_TEST_MODE=true

# Envelope From for every email StageStack sends. OPTIONAL; defaults to
# "StageStack <hello@stagestack.dev>", which only works for the hosted product.
# Set it to an address on a domain verified in YOUR Resend account, or real
# sends bounce/fail.
MAIL_FROM=StageStack <hello@example.org>

# Signing secret from the Resend webhook pointed at
# https://<deployment>.convex.site/resend-webhook. OPTIONAL but strongly
# recommended: without it delivery/bounce events never arrive, so the comms log
# shows every message stuck at "queued".
RESEND_WEBHOOK_SECRET=whsec_xxx

# Public origin of the web app, e.g. https://events.example.org. OPTIONAL but
# effectively required in production: it is the base of every link inside an
# email (portal, CFP, invitations), defaulting to https://stagestack.dev — so a
# self-host without it emails links to someone else's site. Read in two places:
# the Convex deployment (emailed links) AND the web server, where it is the
# fallback origin for SSR metadata when no request Host is available.
SITE_URL=https://events.example.org

# Shared secret the worker presents on every worker-scoped function call. Only
# needed with the import agent, and it must be the SAME value on the deployment
# and on the VM; a mismatch fails every worker call with "forbidden".
WORKER_SECRET=generate-a-long-random-string

# ── [worker] apps/worker on the VM (import agent only) ───────────────────
# Convex deployment URL the worker subscribes to (the .convex.cloud URL, same
# deployment as VITE_CONVEX_URL). REQUIRED for the worker: it exits at boot
# with "Missing CONVEX_URL or WORKER_SECRET env vars".
CONVEX_URL=https://your-deployment.convex.cloud

# OpenRouter key for the import agent's LLM calls. REQUIRED for the worker:
# import planning is the only thing the worker does, and it cannot plan without
# a model. Everything else in StageStack works without it.
OPENROUTER_API_KEY=sk-or-xxx

# ── [ci] the hosting provider's build environment ────────────────────────
# Deploy key that lets `npx convex deploy` push the backend from CI without an
# interactive login. Create one with
# `npx convex deployment token create ci --deployment prod` (or `--deployment
# staging`). Set it in your host's env vars, NOT in a file — anyone holding it
# can deploy to that backend. It needs the `deployment:deploy` AND
# `deployment:data:view` permissions; deploy validates the schema against
# existing data, so a deploy-only key fails.
#CONVEX_DEPLOY_KEY=prod:your-deployment|xxx

# ── [scripts] scripts/deploy-worker.sh (maintainer convenience) ──────────
# SSH target of the worker VM; the script refuses to run without it. The
# identity/path/unit overrides are optional — see the script's header.
WORKER_SSH_HOST=deploy@worker.example.com
#WORKER_SSH_IDENTITY=/path/to/private_key
#WORKER_APP_DIR=/home/exedev/stagestack/app
#WORKER_SERVICE=stagestack-worker
